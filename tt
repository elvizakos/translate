#!/usr/bin/env bash

protocol="http"
host="libretranslate.rpi5.home.lan"
path="/translate"

sLang="auto"
dLang="el"

alternatives="1"

format="text"

apiKey=""

if [ "$#" -gt "0" ]; then

	IFS=":" read -ra langarr <<< "$1"

	if [ "${#langarr[@]}" == "2" ]; then
		shift
		[ "${#langarr[0]}" -gt 1 ] && sLang="${langarr[0]}" || sLang="auto"
		[ "${#langarr[1]}" -gt 1 ] && dLang="${langarr[1]}"
	fi
fi

if read -t 0 ; then
	q="$(cat /dev/stdin)"
else
	q="$1"
fi

q="$(echo -n $q | jq -R -s -c)"

resp="$(curl -sS -H 'Content-Type: application/json' -X POST --data "{\"q\":$q,\"source\":\"$sLang\",\"target\":\"$dLang\",\"format\":\"$format\",\"alternatives\":\"$alternatives\",\"api_key\":\"$apiKey\"}" http://libretranslate.rpi5.home.lan/translate)"

echo "$resp" | jq -r '.["translatedText"]'
