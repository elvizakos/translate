#!/usr/bin/env bash

protocol="http"
hosts=(
	# "qtranslator.rpi5.home.lan"
	"libretranslate.rpi5.home.lan"
)
host=auto
#host=libretranslate.rpi5.home.lan
path="/translate"
health="/health"

sLang="auto"
dLang="el"

alternatives="2"

format="text"

apiKey=""


function getFirstWorkingService () {
	for i in $@; do
		ping -c1 "$i" > /dev/null 2>&1 || continue
		ret="$(curl -sS -H 'Content-Type: application/json' "$i/health" | jq -r '.status')"
		[ "$ret" == "ok" ] && {
			echo "$i"
			return 0
		}
	done
	echo "false"
	return 1
}

function getLangFullTitle () {

	local langsS=( "en" "de" "el" "ru" "tu" )
	local langsE=(
		"English"
		"German"
		"Greek"
		"Russian"
		"Turkish"
	)
	local langsT=(
		"English"
		"Deutsch"
		"Ελληνικά"
		"Русский"
		"Türkçe"
	)

	for i in "${!langsS[@]}"; do
		[ "${langsS[$i]}" == "$1" ] && { echo -n "${langsT[$i]}"; return 0 ; }
	done
	return 1
}

if [ "$#" -gt "0" ]; then

	IFS=":" read -ra langarr <<< "$1"

	if [ "${#langarr[@]}" == "2" ]; then
		shift
		[ "${#langarr[0]}" -gt 1 ] && sLang="${langarr[0]}" || sLang="auto"
		[ "${#langarr[1]}" -gt 1 ] && dLang="${langarr[1]}"
	fi
fi

if read -t 0 ; then
	q="$(cat /dev/stdin)"
else
	q="$1"
fi

shift

if [ "$#" -gt 0 ]; then
	host="$1"
fi

[ "$host" == "auto" ] && host="$(getFirstWorkingService ${hosts[@]})"

# ping -c1 "$host" > /dev/null 2>&1 || {
[ "$host" == "false" ] && {
	[ "$sLang" == "auto" ] && sLang=""
	echo "$q" | trans "$sLang:$dLang"
	exit $?
}

q="$(echo -n $q | jq -R -s -c)"

resp="$(curl -sS -H 'Content-Type: application/json' -X POST --data "{\"q\":$q,\"source\":\"$sLang\",\"target\":\"$dLang\",\"format\":\"$format\",\"alternatives\":\"$alternatives\",\"api_key\":\"$apiKey\"}" http://libretranslate.rpi5.home.lan/translate)"

q="$(echo "$q" | jq -r)"

echo "$q"
echo ""
echo -e "\e[1m$(echo -n "$resp" | jq -r '.translatedText')\e[m"
echo ""
echo -e "Μεταφράσεις του \e[4m$q\e[m"
echo -n "[ "
getLangFullTitle "$(echo "$resp" | jq -r '.detectedLanguage.language')"
echo -en " -> \e[1m"
getLangFullTitle "$dLang"
echo -e "\e[m ]"
echo ""
echo -e "\e[4m$q\e[m"
while read i; do
	echo -e "	\e[1m$i\e[m"
done < <(echo "$resp" | jq -r '.alternatives[]')
